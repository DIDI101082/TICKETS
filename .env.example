# --- Supabase (obligatorio) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=https://tu-app.vercel.app
NEXT_PUBLIC_APP_NOMBRE=Mesa de Ayuda
# Poner 1 para mostrar el botón "Ingresar con Microsoft" (requiere activar Azure en Supabase Auth)
NEXT_PUBLIC_MICROSOFT=0

# --- IA para derivar tickets (opcional: sin clave, todo cae en triage manual) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
# Confianza mínima (0 a 1) para derivar sin intervención
AI_UMBRAL=0.7
# Opcional: gateway compatible con la API de Anthropic (por ejemplo un proxy LiteLLM)
AI_BASE_URL=

# --- Entrada por email / Teams (webhook) ---
ENTRADA_SECRET=poner-una-clave-larga

# --- Avisos (opcionales) ---
TEAMS_WEBHOOK_URL=
RESEND_API_KEY=
EMAIL_FROM=Mesa de Ayuda <soporte@tudominio.com>
# Casilla que lee el flujo de entrada; las respuestas de los usuarios van ahí
EMAIL_SOPORTE=soporte@tudominio.com

# --- Cron de alertas SLA (Vercel lo envía como Bearer) ---
CRON_SECRET=poner-otra-clave-larga
